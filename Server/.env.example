# Copy this file to .env and fill in real values. Never commit the real .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Locally this might point at a Docker
# container, in production it should point at your managed Postgres
# instance (with pgvector available once the RAG milestone lands).
DATABASE_URL=

# Must match the origin the Next.js frontend runs on. Required for CORS
# and for cookies to be sent with credentials.
CLIENT_ORIGIN=http://localhost:3000,https://my-right-steel.vercel.app

# Cookie names, only change these if you have a reason to.
SESSION_COOKIE_NAME=myright_session
CSRF_COOKIE_NAME=myright_csrf
SESSION_TTL_DAYS=14

# Used by the RAG/AI pipeline. Leave GEMINI_API_KEY blank to develop
# without AI features, everything else will still work. Verify these
# model names against https://ai.google.dev/gemini-api/docs/models before
# deploying, Gemini's model lineup changes fairly often.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Object storage. "local" writes to disk for development, set to "s3" and
# fill in the rest for AWS S3 / Cloudflare R2 / Backblaze B2 / MinIO.
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
