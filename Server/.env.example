# Copy this file to .env and fill in real values. Never commit the real .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string used by the running app. If your provider
# offers a separate pooled connection string (Layerbase, Neon, Supabase,
# etc.), use the POOLED one here.
DATABASE_URL=postgresql://myright:myright@localhost:5432/myright

# Used only by Prisma CLI commands (migrate, studio, db push), never by
# the running app. Use the DIRECT (unpooled) connection string here if
# your provider has one, schema migrations run more reliably outside a
# transaction-mode pooler. If your provider only gives you a single
# connection string, set this to the same value as DATABASE_URL.
DIRECT_URL=postgresql://myright:myright@localhost:5432/myright

# Used only by `prisma migrate dev` (a local development command), never
# by the running app or by `prisma migrate deploy`. Managed Postgres
# hosts (Render, Layerbase, etc.) don't grant your app's role Postgres
# superuser, which migrate dev's shadow-database step needs, so point
# this at a separate, empty scratch database instead. Not needed in
# Render's own environment variables for the deployed service, only in
# your local .env.
SHADOW_DATABASE_URL=postgresql://myright:myright@localhost:5432/myright_shadow

# Must match the origin(s) the Next.js frontend runs on. Required for
# CORS and for cookies to be sent with credentials. Comma-separated if
# you have more than one (e.g. local dev plus your deployed frontend):
#   CLIENT_ORIGIN=http://localhost:3000,https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:3000

# Cookie names, only change these if you have a reason to.
SESSION_COOKIE_NAME=myright_session
CSRF_COOKIE_NAME=myright_csrf
SESSION_TTL_DAYS=14

# Used by the RAG/AI pipeline. Leave GEMINI_API_KEY blank to develop
# without AI features, everything else will still work. Verify these
# model names against https://ai.google.dev/gemini-api/docs/models before
# deploying, Gemini's model lineup changes fairly often, and older models
# can stop working before their officially announced shutdown date (this
# happened to gemini-2.5-flash, this project's original default, in mid
# 2026). If AI requests start failing with a 502, check this value first.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Object storage. "local" writes to disk for development, set to "s3" and
# fill in the rest for AWS S3 / Cloudflare R2 / Backblaze B2 / MinIO.
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Google OAuth, only needed for the "connect Google Meet" feature (a
# lawyer connects their own calendar to auto-create Meet links for
# mediation sessions). Create credentials at
# https://console.cloud.google.com/apis/credentials (OAuth client ID,
# type "Web application"). The redirect URI must exactly match what's
# registered there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/mediation/google/callback

# 32-byte key (64 hex chars) used to encrypt Google refresh tokens at
# rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# WhatsApp notifications via Baileys (see
# src/infrastructure/notifications/whatsapp.provider.ts for the important
# caveats before turning this on). Set true, start the server, then have
# a SuperAdmin scan the QR code from the admin dashboard to link a real
# WhatsApp number.
WHATSAPP_ENABLED=false
WHATSAPP_AUTH_DIR=./whatsapp-auth

# Frontend origin, used to build links sent in notifications (e.g. the
# resolution signing link) and to redirect back to after Google OAuth.
APP_URL=http://localhost:3000
