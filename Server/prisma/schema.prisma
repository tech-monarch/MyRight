// MyRight database schema.
//
// Design notes (see README.md "Database" section for the full writeup):
// - Courthouse scoping for lawyers/SuperAdmins is derived through
//   CaseAssignment rather than stored redundantly on Dispute, so there is
//   one source of truth for "which courthouse can see this case."
// - Disputes are soft deleted (deletedAt) because dispute records may need
//   to remain available for audit purposes even after a user requests
//   deletion. Users are deactivated, not deleted, for the same reason.
// - AuditLog is append only at the application layer: no update/delete
//   route is ever exposed for it.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  // `prisma migrate dev` needs a scratch database to diff against, and
  // part of that process requires terminating stale connections, which
  // needs Postgres superuser. Managed hosts like Render don't grant that
  // to your app's role, so without this, migrate dev tries (and fails)
  // to manage a shadow database inside your real one. Point this at a
  // separate, empty database instead, `migrate deploy` (what actually
  // runs against production) never uses this at all, so it's a dev-only
  // requirement.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  extensions        = [vector]
}

enum UserRole {
  DISPUTANT
  LAWYER
  // Courthouse administrator: full control inside their own courthouse.
  SUPERADMIN
  // The platform owner (the company running MyRight): manages every
  // courthouse, creates courthouse admins, sets the default WhatsApp number.
  // Deliberately has NO access to individual disputes.
  PLATFORM_ADMIN
  // Courthouse staff delegated specific powers by a courthouse admin, see
  // User.permissions.
  COURTHOUSE_STAFF
}

enum PartyResponse {
  PENDING
  ACCEPTED
  DECLINED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum DisputeStatus {
  DRAFT
  UNDER_REVIEW
  MEDIATION_REQUESTED
  AWAITING_OTHER_PARTY
  MEDIATOR_ASSIGNED
  IN_MEDIATION
  RESOLVED
  WITHDRAWN
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum AuditResult {
  SUCCESS
  DENIED
}

model Courthouse {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("courthouses")
}

// A single table covers all three roles rather than separate Disputant /
// Lawyer / SuperAdmin tables. The roles share enough shape (credentials,
// status, audit trail) that splitting them would just mean joining them
// back together everywhere; `role` plus the nullable lawyer-only fields is
// simpler to reason about and query.
model User {
  id                 String     @id @default(cuid())
  role               UserRole
  status             UserStatus @default(ACTIVE)
  name               String
  email              String?    @unique
  // Only lawyers/SuperAdmins log in by username; disputants use email.
  username           String?    @unique
  phone              String?
  passwordHash       String
  mustChangePassword Boolean    @default(false)
  // Only meaningful for COURTHOUSE_STAFF: MANAGE_LAWYERS, ASSIGN_CASES, VIEW_CASES.
  permissions        String[]   @default([])
  specialization     String?
  courthouseId       String?
  courthouse         Courthouse? @relation(fields: [courthouseId], references: [id])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  sessions          Session[]
  disputes          Dispute[]         @relation("DisputeOwner")
  assignments       CaseAssignment[]  @relation("LawyerAssignments")
  assignmentsMade   CaseAssignment[]  @relation("AssignedBy")
  uploadedDocuments Document[]
  statusChanges     DisputeStatusHistory[]
  availability      MediatorAvailability[] @relation("LawyerAvailability")
  mediationSessions MediationSession[]     @relation("MediatorSessions")
  resolutionsCreated Resolution[]
  notifications      Notification[]

  @@index([courthouseId])
  @@map("users")
}

// Sessions are stored server side (a token row per login) rather than
// stateless JWTs, so a SuperAdmin action like "deactivate this lawyer" or
// a user's own "log out everywhere" takes effect immediately instead of
// waiting for a token to expire. Only a hash of the token is stored, the
// raw token only ever lives in the httpOnly cookie.
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([userId])
  @@map("sessions")
}

model Dispute {
  id                 String        @id @default(cuid())
  ownerId            String
  owner              User          @relation("DisputeOwner", fields: [ownerId], references: [id])
  title              String
  description        String
  type               String
  otherPartyName     String?
  otherPartyContact  String?
  desiredOutcome     String?
  status             DisputeStatus @default(DRAFT)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?
  // The other party's answer to the mediation invitation. Null until an
  // invitation has been sent.
  otherPartyResponse    PartyResponse?
  otherPartyRespondedAt DateTime?

  invitations   MediationInvitation[]
  assignment    CaseAssignment?
  documents     Document[]
  statusHistory DisputeStatusHistory[]
  chatMessages  ChatMessage[]
  aiAnalyses    AIAnalysis[]
  mediationSessions MediationSession[]
  resolutions       Resolution[]

  @@index([ownerId])
  @@map("disputes")
}

model DisputeStatusHistory {
  id         String        @id @default(cuid())
  disputeId  String
  dispute    Dispute       @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  status     DisputeStatus
  note       String?
  changedById String?
  changedBy  User?         @relation(fields: [changedById], references: [id])
  createdAt  DateTime      @default(now())

  @@index([disputeId])
  @@map("dispute_status_history")
}

// One active lawyer per case is enough for the product today (see the
// RBAC "do not overbuild" principle). disputeId is unique so assigning a
// new lawyer replaces the row rather than accumulating history, full
// assignment history is available through AuditLog if it's ever needed.
model CaseAssignment {
  id           String   @id @default(cuid())
  disputeId    String   @unique
  dispute      Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  lawyerId     String
  lawyer       User     @relation("LawyerAssignments", fields: [lawyerId], references: [id])
  assignedById String
  assignedBy   User     @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  @@index([lawyerId])
  @@map("case_assignments")
}

model Document {
  id           String         @id @default(cuid())
  disputeId    String
  dispute      Dispute        @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploaderId   String
  uploader     User           @relation(fields: [uploaderId], references: [id])
  fileName     String
  storageKey   String         // Object storage key/path, never a public URL.
  mimeType     String
  sizeBytes    Int
  // UPLOADED -> PROCESSING (ingestion running) -> READY (searchable by RAG)
  // or FAILED. A document a user can already see and download does not
  // have to be READY, ingestion only controls whether the AI assistant
  // can retrieve its content.
  status       DocumentStatus @default(UPLOADED)
  ingestError  String?
  createdAt    DateTime       @default(now())

  chunks DocumentChunk[]

  @@index([disputeId])
  @@map("documents")
}

// One row per chunk of extracted text from a user-uploaded document.
// disputeId is denormalized from Document here on purpose: retrieval
// needs to filter "chunks belonging to disputes this user can access"
// on every single query, and filtering a vector search directly by a
// plain indexed column is both simpler and faster than joining through
// Document every time. See rag/retrieval.service.ts.
model DocumentChunk {
  id         String                @id @default(cuid())
  documentId String
  document   Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  disputeId  String
  content    String
  embedding  Unsupported("vector(768)")?
  pageNumber Int?
  chunkIndex Int
  createdAt  DateTime              @default(now())

  @@index([disputeId])
  @@index([documentId])
  @@map("document_chunks")
}

enum KnowledgeSourceType {
  LEGISLATION
  ADR_FRAMEWORK
  GUIDANCE
  CASE_LAW
  OTHER
}

enum AuthorityLevel {
  AUTHORITATIVE
  INFORMATIONAL
}

// The curated legal/ADR knowledge base, kept deliberately separate from
// user-uploaded Documents: knowledge chunks are shared across every
// dispute (no disputeId), document chunks are private to one dispute.
// Mixing the two tables would make it easy to accidentally leak one
// user's uploaded evidence into another user's retrieval results.
model KnowledgeSource {
  id              String              @id @default(cuid())
  title           String
  sourceType      KnowledgeSourceType
  authorityLevel  AuthorityLevel
  jurisdiction    String?
  sourceUrl       String?
  version         String?
  publicationDate DateTime?
  effectiveDate   DateTime?
  createdAt       DateTime            @default(now())

  chunks KnowledgeChunk[]

  @@map("knowledge_sources")
}

model KnowledgeChunk {
  id         String                @id @default(cuid())
  sourceId   String
  source     KnowledgeSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  content    String
  embedding  Unsupported("vector(768)")?
  section    String?
  pageNumber Int?
  chunkIndex Int
  createdAt  DateTime              @default(now())

  @@index([sourceId])
  @@map("knowledge_chunks")
}

enum ChatRole {
  USER
  ASSISTANT
}

// The dispute-scoped AI Assistant conversation. Kept as its own table
// (not folded into DisputeStatusHistory or similar) because chat grows
// unbounded and is read/written far more often than status changes are.
model ChatMessage {
  id        String   @id @default(cuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String
  // Titles/ids of the sources cited in this message, empty for USER
  // messages and for ASSISTANT messages that found nothing to cite.
  sources   Json?
  createdAt DateTime @default(now())

  @@index([disputeId])
  @@map("chat_messages")
}

// A snapshot of the structured RAG analysis at the time it was generated.
// Disputes can be re-analyzed (e.g. after more evidence is uploaded), so
// this is an append-only history rather than a single field on Dispute.
model AIAnalysis {
  id        String   @id @default(cuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  result    Json
  createdAt DateTime @default(now())

  @@index([disputeId])
  @@map("ai_analyses")
}

// ---------------------------------------------------------------------
// Mediation scheduling, embedded video (Daily.co), e-signature, notifications
// ---------------------------------------------------------------------

// A lawyer's recurring weekly availability, expressed as minutes from
// midnight (Africa/Lagos, UTC+1, no DST to worry about) rather than
// absolute datetimes, since "Mondays 9-11am" repeats indefinitely and
// storing it as recurring rows is simpler than generating and maintaining
// a slot per future week.
model MediatorAvailability {
  id          String   @id @default(cuid())
  lawyerId    String
  lawyer      User     @relation("LawyerAvailability", fields: [lawyerId], references: [id], onDelete: Cascade)
  dayOfWeek   Int      // 0 = Sunday .. 6 = Saturday
  startMinute Int      // minutes from midnight, e.g. 540 = 9:00am
  endMinute   Int
  createdAt   DateTime @default(now())

  @@index([lawyerId])
  @@map("mediator_availability")
}

enum MediationSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model MediationSession {
  id             String                 @id @default(cuid())
  disputeId      String
  dispute        Dispute                @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  lawyerId       String
  lawyer         User                   @relation("MediatorSessions", fields: [lawyerId], references: [id])
  scheduledStart DateTime
  scheduledEnd   DateTime
  // The Daily.co room URL, participants join by opening this directly or
  // (normally) through the embedded prebuilt UI on the case detail page.
  // Nullable to accommodate a manually pasted link (Zoom, etc.) for a
  // mediator who prefers a different tool, the UI doesn't distinguish
  // the two, it just shows whichever is present.
  meetingUrl     String?
  // Daily's room `name`, needed to delete the room on cancellation and to
  // query attendance afterward. Null when meetingUrl is a manually
  // pasted link rather than a Daily-created room.
  dailyRoomName  String?
  status         MediationSessionStatus @default(SCHEDULED)
  // A free-text summary the mediator fills in after the session, not a
  // resolution's binding terms (see the Resolution model for that), just
  // "what happened in this session", useful even when no agreement was
  // reached yet and another session gets scheduled later.
  outcomeNotes   String?
  createdById    String
  createdAt      DateTime               @default(now())

  attendance MediationAttendance[]

  @@index([disputeId])
  @@index([lawyerId])
  @@map("mediation_sessions")
}

// One row per person who actually joined a session, pulled from Daily's
// presence data after the call. This is an attendance record for the
// dispute process ("did both sides actually show up"), not a live
// presence feed, MyRight doesn't need real-time tracking, just a
// dependable record afterward.
model MediationAttendance {
  id          String           @id @default(cuid())
  sessionId   String
  session     MediationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantName String
  joinedAt    DateTime?
  leftAt      DateTime?
  durationSec Int?
  recordedAt  DateTime         @default(now())

  @@index([sessionId])
  @@map("mediation_attendance")
}

enum ResolutionStatus {
  AWAITING_SIGNATURES
  FULLY_SIGNED
  VOID
}

// The terms both sides agree to. Kept separate from Dispute (rather than
// a field on it) because it has its own lifecycle and its own signatures,
// and because a case could in principle go through more than one draft of
// terms before both sides accept.
model Resolution {
  id          String            @id @default(cuid())
  disputeId   String
  dispute     Dispute           @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  terms       String
  status      ResolutionStatus  @default(AWAITING_SIGNATURES)
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  signatures     ResolutionSignature[]
  signingTokens  ResolutionSigningToken[]

  @@index([disputeId])
  @@map("resolutions")
}

enum SigningParty {
  DISPUTANT
  OTHER_PARTY
}

// A simple "typed name + timestamp + IP" signature, not a cryptographic
// digital signature. This is what most consumer e-sign flows actually
// are under the hood, but it's worth being explicit: this is evidence of
// intent to agree, not a notarized or cryptographically verifiable
// signature, and MyRight should not claim otherwise to users. See
// README "AI Limitations" (well, this one belongs in a "Legal
// Limitations" section, added alongside this feature).
model ResolutionSignature {
  id           String       @id @default(cuid())
  resolutionId String
  resolution   Resolution   @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  party        SigningParty
  signerName   String
  userId       String?      // set for the disputant (an authenticated User), null for the other party
  ipAddress    String?
  userAgent    String?
  signedAt     DateTime     @default(now())

  @@unique([resolutionId, party])
  @@map("resolution_signatures")
}

// The other party has no MyRight account, they reach the signing page
// through a single-use token sent by WhatsApp/email rather than logging
// in. Same hashed-token-in-DB pattern as Session (see
// utils/session-token.ts), for the same reason: only a hash is stored, so
// a leaked database doesn't hand over a usable signing link.
model ResolutionSigningToken {
  id           String     @id @default(cuid())
  resolutionId String
  resolution   Resolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([resolutionId])
  @@map("resolution_signing_tokens")
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

// A log, not a queue, notifications are sent inline from whatever
// triggered them (see notifications/notification.service.ts) and this
// just records what happened. Useful for debugging "did the other party
// actually get notified" without needing to check WhatsApp/email
// provider dashboards.
model NotificationLog {
  id        String              @id @default(cuid())
  userId    String?
  channel   NotificationChannel
  recipient String
  template  String
  status    NotificationStatus
  error     String?
  createdAt DateTime            @default(now())

  @@index([userId])
  @@map("notification_logs")
}

// Append only by convention: no route ever updates or deletes a row here.
// actorLabel is denormalized so the log stays readable even if the actor
// account is later deactivated or its name changes.
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actorLabel String
  action     String
  targetType String
  targetId   String?
  result     AuditResult
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}


// A single-use-style link sent to the other party (who has no account) so
// they can accept or decline mediation. Only a hash of the token is stored.
model MediationInvitation {
  id        String   @id @default(cuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([disputeId])
  @@map("mediation_invitations")
}

// In-app notifications shown in the bell/notifications pages. Distinct from
// NotificationLog, which records WhatsApp/email delivery attempts.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

// Small key/value store for platform-wide settings (e.g. the default
// WhatsApp number), editable from the platform admin dashboard.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// One linked WhatsApp account. scopeKey is "platform" for the default
// number, or a courthouse id for a courthouse's own number. Baileys' login
// credentials live here (not on disk) because Render's disk is wiped on
// every deploy.
model WhatsAppSession {
  scopeKey    String   @id
  phoneNumber String?
  creds       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  keys WhatsAppAuthKey[]

  @@map("whatsapp_sessions")
}

model WhatsAppAuthKey {
  scopeKey String
  type     String
  keyId    String
  value    String
  session  WhatsAppSession @relation(fields: [scopeKey], references: [scopeKey], onDelete: Cascade)

  @@id([scopeKey, type, keyId])
  @@map("whatsapp_auth_keys")
}
