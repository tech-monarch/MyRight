# Copy to .env.local for local development.

# Server-side only (deliberately not NEXT_PUBLIC_, the browser never
# calls this directly). Used by next.config.mjs's rewrite to proxy
# /api/* through this same origin to the real backend, which keeps the
# session cookie first-party from the browser's point of view. Required
# on Vercel too, set it in your Vercel project's Environment Variables.
API_ORIGIN=http://localhost:4000
